# The other half of the line-ending story.
#
# .gitattributes fixes what git STORES and checks out. This fixes what an
# editor WRITES in the first place, so a file never has to be normalised.
#
# Honest caveat: this is only honoured by editors that support it. VS Code
# needs the EditorConfig extension; Notepad ignores it completely. That is
# exactly why .gitattributes exists as well - it is the backstop that works
# regardless of who edited the file with what.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
