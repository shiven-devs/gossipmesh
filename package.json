{
  "name": "gossipmesh",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized cluster-membership and failure-detection service built on a push-pull gossip protocol",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:legacy": "node legacy/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "cluster:local": "bash scripts/local-cluster.sh",
    "lint": "eslint .",
    "e2e": "node scripts/e2e-check.mjs"
  },
  "keywords": [
    "gossip-protocol",
    "failure-detection",
    "distributed-systems",
    "kubernetes"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "express": "^4.19.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "supertest": "^7.3.2"
  }
}
